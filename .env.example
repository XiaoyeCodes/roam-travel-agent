# Server-only configuration. Never use a VITE_ prefix for secrets.
PORT=8787
HOST=127.0.0.1
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
AMAP_KEY=
# Browser-visible JS API credentials, also included in interactive HTML exports.
# Use a separate Web (JS API) key, not AMAP_KEY. New keys require a security code.
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
UNSPLASH_ACCESS_KEY=
TAVILY_API_KEY=
# Optional remote MCP servers. roles: attractions, transport, weather, hotel, food, route
# Built-in 12306 and fast-flights start automatically; no ticket API keys required.
# Set ROAM_TICKETS_DISABLED=1 only to disable them (e.g. offline tests).
# MCP_SERVERS=[{"id":"rail","name":"12306","url":"http://127.0.0.1:8000/mcp","transport":"http","roles":["transport"]}]
# Chromium / Chrome / Edge path for PDF export (auto-detected on Windows)
BROWSER_EXECUTABLE_PATH=
# If binding to a public interface, set a bearer token and use a reverse proxy with TLS.
APP_ACCESS_TOKEN=
